# Всё, что здесь есть, можно задать и в админке — она пишет то же самое в базу
# и имеет приоритет над этим файлом. Здесь удобно поднимать бота с нуля.
# Открыть админку: /admin в боте, или http://127.0.0.1:8765

# ==== Telegram ==============================================================
TG_TOKEN=

# ==== LLM ===================================================================
# Провайдер выбирается сам по тому, какой ключ заполнен: kie -> openrouter ->
# anthropic. LLM_PROVIDER задаётся, только если нужно перебить этот выбор.
LLM_PROVIDER=

KIE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Слаг модели у kie.ai живёт в пути, а не в теле запроса.
KIE_BASE=https://api.kie.ai/{model}/v1

# Пусто — берутся дефолты провайдера (у kie это gemini-3-7-flash-openai везде).
MODEL_SCREEN=
MODEL_IDEATE=
MODEL_WRITE=

# ==== Картинки и озвучка ====================================================
REPLICATE_API_TOKEN=

# Озвучка по умолчанию — Edge TTS, бесплатно и без ключа. Ключ нужен, только
# если переключить движок на ElevenLabs в админке или в настройках бота.
ELEVENLABS_API_KEY=

# ==== Источники =============================================================
# Reddit идёт через Arctic Shift — учётные данные не нужны.
# Токен GitHub необязателен: поднимает лимит поиска с 10 до 30 запросов в минуту.
GITHUB_TOKEN=

# ==== Cloudflare R2 =========================================================
# Пара S3-ключей: Cloudflare -> R2 -> Manage API tokens. Отдельный API-токен
# (cfut_...) здесь НЕ используется — boto3 ходит по S3-протоколу.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Префикс внутри общего с ugc-cg бакета, чтобы архивы не перемешались.
R2_PREFIX=painbot/

# Публичный домен бакета. Пусто = ссылки выдаются presigned на 7 дней.
R2_PUBLIC_BASE=

# ==== Видео =================================================================
# Геометрия ролика. Меняется и в админке, но применяется после перезапуска.
FRAME_W=1080
FRAME_H=1920
FRAME_FPS=24

# Пусто — берётся bin/ffmpeg.exe рядом с проектом.
FFMPEG_PATH=

# ==== Админка ===============================================================
# Слушает только 127.0.0.1. Порт можно сменить, если 8765 занят.
ADMIN_PORT=8765
